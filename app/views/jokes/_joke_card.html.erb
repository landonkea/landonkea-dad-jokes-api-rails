<%# The full joke card: category badge, groan meter, setup line, a
    reveal-the-punchline toggle, vote buttons, and the author credit. Used on
    both the random-joke page and a single joke's own page. Takes two locals:
    "joke" (the Joke record) and "already_voted" (whether this visitor has
    already voted on it). %>
<div class="bg-white rounded-2xl shadow-md p-6 space-y-4">
  <div class="flex items-center justify-between">
    <span class="inline-block px-3 py-1 rounded-full bg-amber-200 text-amber-900 text-xs font-semibold uppercase tracking-wide">
      <%= joke.category.name %>
    </span>
    <span class="text-sm text-stone-500">
      Groan Level: <span class="text-base"><%= groan_meter(joke.groan_level) %></span> <%= joke.groan_level %>/10
    </span>
  </div>

  <div>
    <p class="text-xs uppercase tracking-wide text-stone-400 mb-1">Setup</p>
    <p class="text-lg font-medium"><%= joke.setup %></p>
  </div>

  <%# The <details>/<summary> pair is a plain HTML element that shows/hides its
      contents when clicked, no JavaScript needed at all. That's what gives us
      the "build anticipation, then reveal the punchline" effect for free. %>
  <details class="group">
    <summary class="cursor-pointer select-none inline-block px-4 py-2 rounded-lg bg-stone-800 text-amber-50 text-sm font-semibold hover:bg-stone-700">
      🥁 Reveal the Punchline 🥁
    </summary>
    <div class="mt-3 border-t border-stone-200 pt-3">
      <p class="text-xs uppercase tracking-wide text-stone-400 mb-1">Punchline</p>
      <p class="text-lg font-semibold text-amber-700"><%= joke.punchline %></p>
      <%# The reaction line is picked fresh on every page render (see
          JokesHelper#groan_reaction_for), so reloading or revisiting the
          same joke can show a different one-liner each time. %>
      <p class="text-sm text-stone-500 mt-2"><%= groan_reaction_for(joke.groan_level) %></p>
    </div>
  </details>

  <div class="flex items-center justify-between pt-2 border-t border-stone-100">
    <%# Renders the shared vote-buttons partial, this is the piece that gets
        swapped out live by Turbo Streams whenever a vote is cast. %>
    <%= render "jokes/vote_buttons", joke: joke, already_voted: already_voted %>
    <span class="text-sm text-stone-400">, <%= joke.author %></span>
  </div>
</div>
