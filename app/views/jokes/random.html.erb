<%# content_for(:title) overrides the <title> tag set in the layout, so the
    browser tab reads something specific to this page instead of the generic default. %>
<% content_for(:title) { "Random Dad Joke" } %>

<h1 class="text-2xl font-bold mb-1">🎲 Random Dad Joke</h1>
<p class="text-stone-500 text-sm mb-6">Roll the dice of dad humor.</p>

<% if @joke %>
  <%# The joke card partial does the heavy lifting, this view is really just
      "get a random joke, hand it to the card, add a button to get another one." %>
  <%= render "jokes/joke_card", joke: @joke, already_voted: @already_voted %>

  <div class="mt-6 text-center">
    <%# Linking back to random_path re-runs the JokesController#random action,
        which re-rolls the dice and picks a brand new joke. %>
    <%= link_to "🔄 Another One", random_path, class: "inline-block px-5 py-2 rounded-lg bg-stone-800 text-amber-50 font-semibold hover:bg-stone-700" %>
  </div>
<% else %>
  <%# Shown only if the jokes table is completely empty, shouldn't happen once
      seed data has run, but it's a friendlier message than a blank page. %>
  <div class="bg-white rounded-2xl shadow-md p-6 text-center text-stone-500">
    No jokes found. The database is as empty as my dad's joke book.
  </div>
<% end %>
